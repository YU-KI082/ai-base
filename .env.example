DATABASE_URL=postgresql://aibase:aibase@localhost:5432/aibase?schema=public
REDIS_URL=redis://localhost:6379

# LLM — vendor-agnostic. Agents + AI BASE OS (/admin) use LlmProvider only.
# Providers: openai | anthropic | claude | gemini | grok | local | mock
# Production OS requires a real provider key (mock is rejected by Marketing OS).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Never enable mock fallback for Marketing OS in production
LLM_FALLBACK_MOCK=false

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

GEMINI_API_KEY=
# GOOGLE_API_KEY=  # alias for GEMINI_API_KEY
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

GROK_API_KEY=
# XAI_API_KEY=     # alias for GROK_API_KEY
GROK_BASE_URL=https://api.x.ai/v1

# Local OpenAI-compatible endpoint (Ollama / vLLM / LM Studio)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=local

# Embeddings — vendor-agnostic (openai | voyage | cohere | jina | bge | ollama | mock)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=64
EMBEDDING_FALLBACK_MOCK=true
VOYAGE_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=
BGE_API_KEY=
# HF_TOKEN=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Vector store — postgres | pgvector | memory | qdrant | pinecone
VECTOR_BACKEND=memory
VECTOR_NAMESPACE=knowledge
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_base_knowledge
PINECONE_API_KEY=
PINECONE_HOST=

# Cache — memory | redis (use redis in multi-instance production)
CACHE_BACKEND=memory
CACHE_PREFIX=aibase:cache:
CACHE_TTL_TOOLS_SECONDS=60

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LOCAL ONLY — ignored when NODE_ENV=production
ADMIN_DEV_BYPASS=true
# ADMIN_DEV_BYPASS_LOCALHOST_ONLY=true

# Customer OS sessions (/login /signup /admin) — HMAC secret (16+ chars recommended)
USER_SESSION_SECRET=replace-with-a-long-random-secret

# Ops console login (/ops/login). Min 16 characters. Required on Vercel.
# ADMIN_OPS_SECRET=replace-with-a-long-random-secret

# Analytics / Search Console (public launch)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=paste-gsc-meta-content

RATE_LIMIT_ADMIN_MUTATION_PER_MIN=60
RATE_LIMIT_PUBLIC_PER_MIN=120

NEXT_PUBLIC_DEFAULT_LOCALE=ja
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EVENT_BUS_STREAM_PREFIX=aibase
OUTBOX_POLL_MS=1000
OUTBOX_MAX_ATTEMPTS=25

# SNS OAuth (Instagram / TikTok) — never store passwords
TOKEN_ENCRYPTION_KEY=replace-with-32-plus-char-random-string
OAUTH_STATE_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_SCOPES=instagram_basic,instagram_content_publish,pages_show_list,pages_read_engagement
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_SCOPES=user.info.basic,video.upload,video.publish
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# X (Twitter) OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access
X_OAUTH_CODE_CHALLENGE=
X_OAUTH_CODE_VERIFIER=

# Threads (Meta)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_OAUTH_SCOPES=threads_basic,threads_content_publish

# note — optional official API; otherwise draft queue
NOTE_API_URL=
NOTE_API_KEY=

# Video render providers (ffmpeg | remotion | external_api)
VIDEO_RENDER_PROVIDER=ffmpeg
FFMPEG_PATH=
VIDEO_OUTPUT_DIR=
VIDEO_PUBLIC_BASE_URL=
VIDEO_PUBLIC_PATH_PREFIX=/sns-media
VIDEO_API_URL=
VIDEO_API_KEY=
REMOTION_ENABLED=0

# Instagram Content Publishing
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Cron
CRON_SECRET=
SNS_DAILY_COST_CAP_USD=
SNS_DAILY_COST_SPENT_USD=

# Research Agent sources (optional)
PRODUCTHUNT_TOKEN=
GITHUB_TOKEN=

# Video / TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
