generator client {
  provider      = "prisma-client-js"
  /// Vercel serverless (Amazon Linux / OpenSSL 3)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  en
  ja
}

enum UserStatus {
  active
  disabled
}

enum UserKind {
  customer
  ops
}

enum AgentStatus {
  active
  disabled
  degraded
}

enum AgentRunStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum WorkflowState {
  started
  reviewing
  writing
  designing
  translating
  seo
  pending_approval
  approved
  rejected
  publishing
  published
  failed
}

enum WorkflowStepStatus {
  pending
  running
  completed
  failed
  skipped
}

enum DraftStatus {
  building
  pending_approval
  approved
  rejected
  published
}

enum DraftKind {
  tool_page
  comparison
  news
  article
}

enum ApprovalDecision {
  approved
  rejected
}

enum ContentStatus {
  draft
  published
  archived
}

enum PricingModel {
  free
  freemium
  paid
  enterprise
  unknown
}

enum MediaType {
  screenshot
  video
  logo
  ogp
  thumbnail
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String?    @map("password_hash")
  kind         UserKind   @default(ops)
  status       UserStatus @default(active)
  locale       Locale     @default(ja)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  roles      UserRole[]
  approvals  Approval[]
  auditLogs  AuditLog[]
  workspaces Workspace[]

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Category {
  id        String   @id @default(cuid())
  key       String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations CategoryTranslation[]
  tools        AiToolCategory[]

  @@map("categories")
}

model CategoryTranslation {
  id          String @id @default(cuid())
  categoryId  String @map("category_id")
  locale      Locale
  name        String
  slug        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

model AiTool {
  id              String       @id @default(cuid())
  slug            String       @unique
  status          ContentStatus @default(draft)
  homepageUrl     String       @map("homepage_url")
  logoUrl         String?      @map("logo_url")
  pricingModel    PricingModel @default(unknown) @map("pricing_model")
  hasFreePlan     Boolean      @default(false) @map("has_free_plan")
  hasApi          Boolean      @default(false) @map("has_api")
  commercialUse   Boolean?     @map("commercial_use")
  sourceUrl       String?      @map("source_url")
  sourceName      String?      @map("source_name")
  externalId      String?      @map("external_id")
  publishedAt     DateTime?    @map("published_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  translations AiToolTranslation[]
  media        AiToolMedia[]
  categories   AiToolCategory[]
  affiliateLinks AffiliateLink[]
  affiliateIntel AffiliateIntelligence?
  reviews      Review[]
  comparisonItems ComparisonItem[]
  drafts       Draft[]
  affiliateConversions AffiliateConversion[]

  @@index([status])
  @@index([externalId, sourceName])
  @@index([homepageUrl])
  @@index([status, publishedAt])
  @@map("ai_tools")
}

model AiToolTranslation {
  id              String @id @default(cuid())
  toolId          String @map("tool_id")
  locale          Locale
  name            String
  description     String
  features        Json   @default("[]")
  pros            Json   @default("[]")
  cons            Json   @default("[]")
  languageSupport Json   @default("[]") @map("language_support")
  tags            Json   @default("[]")
  useCases        Json   @default("[]") @map("use_cases")
  recommendedUsers Json  @default("[]") @map("recommended_users")
  pricingNotes    String? @map("pricing_notes")
  seoTitle        String? @map("seo_title")
  seoDescription  String? @map("seo_description")
  faq             Json    @default("[]")
  schemaJson      Json?   @map("schema_json")

  tool AiTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, locale])
  @@index([locale, name])
  @@map("ai_tool_translations")
}

model AiToolMedia {
  id        String    @id @default(cuid())
  toolId    String    @map("tool_id")
  type      MediaType
  url       String
  alt       String?
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  tool AiTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId, type])
  @@map("ai_tool_media")
}

model AiToolCategory {
  toolId     String @map("tool_id")
  categoryId String @map("category_id")

  tool     AiTool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([toolId, categoryId])
  @@map("ai_tool_categories")
}

model AffiliateLink {
  id           String   @id @default(cuid())
  toolId       String   @map("tool_id")
  label        String
  url          String
  network      String?
  commission   String?
  isHealthy    Boolean  @default(true) @map("is_healthy")
  priority     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tool     AiTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  aspLeads AffiliateAspLead[]
  conversions AffiliateConversion[]

  @@index([toolId])
  @@map("affiliate_links")
}

/// Per-tool affiliate intelligence — created as uninvestigated when a tool is published.
model AffiliateIntelligence {
  id              String   @id @default(cuid())
  toolId          String   @unique @map("tool_id")
  /// Overall case status: uninvestigated | investigating | available | applying | partnered | unavailable
  status          String   @default("uninvestigated")
  /// null = unknown / 未確認
  hasAffiliate    Boolean? @map("has_affiliate")
  homepageUrl     String?  @map("homepage_url")
  notes           String?
  lastReviewedAt  DateTime? @map("last_reviewed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tool AiTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  leads AffiliateAspLead[]

  @@index([status])
  @@map("affiliate_intelligence")
}

/// AI-proposed ASP investigation targets (official / A8 / もしも / アクセストレード / バリューコマース).
model AffiliateAspLead {
  id               String    @id @default(cuid())
  intelligenceId   String    @map("intelligence_id")
  toolId           String    @map("tool_id")
  /// official | a8 | moshimo | accesstrade | valuecommerce
  aspKey           String    @map("asp_key")
  aspLabel         String    @map("asp_label")
  status           String    @default("uninvestigated")
  rewardText       String?   @map("reward_text")
  rewardAmount     Decimal?  @map("reward_amount") @db.Decimal(12, 2)
  cookieDays       Int?      @map("cookie_days")
  conversionTerms  String?   @map("conversion_terms")
  appliedAt        DateTime? @map("applied_at")
  approvedAt       DateTime? @map("approved_at")
  affiliateLinkId  String?   @map("affiliate_link_id")
  proposedBy       String    @default("agent") @map("proposed_by")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  intelligence  AffiliateIntelligence @relation(fields: [intelligenceId], references: [id], onDelete: Cascade)
  affiliateLink AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)

  @@unique([toolId, aspKey])
  @@index([status])
  @@index([aspKey])
  @@map("affiliate_asp_leads")
}

/// Conversion / sale events for EPC・CVR analysis (never invent — ingest real ASP reports or manual).
model AffiliateConversion {
  id              String   @id @default(cuid())
  toolId          String   @map("tool_id")
  affiliateLinkId String?  @map("affiliate_link_id")
  aspKey          String?  @map("asp_key")
  amountUsd       Decimal  @map("amount_usd") @db.Decimal(12, 2)
  occurredAt      DateTime @map("occurred_at")
  source          String   @default("manual")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  tool          AiTool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  affiliateLink AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)

  @@index([toolId, occurredAt])
  @@index([occurredAt])
  @@map("affiliate_conversions")
}

model Comparison {
  id          String        @id @default(cuid())
  slug        String        @unique
  status      ContentStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  translations ComparisonTranslation[]
  items        ComparisonItem[]

  @@map("comparisons")
}

model ComparisonTranslation {
  id             String @id @default(cuid())
  comparisonId   String @map("comparison_id")
  locale         Locale
  title          String
  summary        String
  recommendation String?
  featureMatrix  Json   @default("{}") @map("feature_matrix")

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, locale])
  @@map("comparison_translations")
}

model ComparisonItem {
  id           String @id @default(cuid())
  comparisonId String @map("comparison_id")
  toolId       String @map("tool_id")
  side         String
  sortOrder    Int    @default(0) @map("sort_order")

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  tool       AiTool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, toolId])
  @@map("comparison_items")
}

model Review {
  id        String   @id @default(cuid())
  toolId    String   @map("tool_id")
  locale    Locale
  rating    Int
  title     String
  body      String
  author    String?
  createdAt DateTime @default(now()) @map("created_at")

  tool AiTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId, locale])
  @@map("reviews")
}

model News {
  id          String        @id @default(cuid())
  slug        String        @unique
  status      ContentStatus @default(draft)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  translations NewsTranslation[]

  @@map("news")
}

model NewsTranslation {
  id      String @id @default(cuid())
  newsId  String @map("news_id")
  locale  Locale
  title   String
  summary String
  body    String

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, locale])
  @@map("news_translations")
}

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  kind        String        @default("guide")
  status      ContentStatus @default(draft)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  translations ArticleTranslation[]

  @@index([status, kind, publishedAt])
  @@map("articles")
}

model ArticleTranslation {
  id             String  @id @default(cuid())
  articleId      String  @map("article_id")
  locale         Locale
  title          String
  summary        String
  body           String
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@map("article_translations")
}

model SocialPost {
  id               String    @id @default(cuid())
  platform         String
  /// draft | pending_approval | ready | scheduled | published | failed | retry | rejected
  status           String    @default("draft")
  locale           Locale
  content          String
  mediaUrl         String?   @map("media_url")
  toolId           String?   @map("tool_id")
  theme            String?
  hook             String?
  hookType         String?   @map("hook_type")
  durationSec      Int?      @map("duration_sec")
  cta              String?
  format           String?
  hashtags         String[]  @default([])
  /// tool_intro | compare | ranking | ai_news | howto | failure | before_after | beginner
  contentKind      String?   @map("content_kind")
  /// TikTok/Reels multi-duration scripts (15/30/60) JSON
  scriptJson       Json?     @map("script_json")
  /// Vertical 9:16 media plan (scenes, BGM, thumbs) JSON
  mediaPlanJson    Json?     @map("media_plan_json")
  subtitleDensity  String?   @map("subtitle_density")
  lastPublishError String?   @map("last_publish_error")
  maxPublishRetries Int      @default(3) @map("max_publish_retries")
  experimentId     String?   @map("experiment_id")
  variantKey       String?   @map("variant_key")
  recommendationId String?   @map("recommendation_id")
  scoreTotal       Float?    @map("score_total")
  scoreBreakdown   Json?     @map("score_breakdown")
  riskFlags        String[]  @default([]) @map("risk_flags")
  contentHash      String?   @map("content_hash")
  autoDecision     Json?     @map("auto_decision")
  publishAttempts  Int       @default(0) @map("publish_attempts")
  scheduledAt      DateTime? @map("scheduled_at")
  externalPostId   String?   @map("external_post_id")
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  experiment      SnsExperiment?      @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  recommendation  SnsRecommendation?  @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  metrics         SnsPostMetrics[]
  scores          SnsPostScore[]

  @@index([platform, status])
  @@index([experimentId])
  @@index([contentHash])
  @@index([contentKind, platform])
  @@map("social_posts")
}

/// Official OAuth connection for Instagram / TikTok.
/// Never stores passwords — only encrypted access/refresh tokens from OAuth.
model SnsOAuthConnection {
  id                    String    @id @default(cuid())
  provider              String
  /// Display status: connected | auto_refreshing | reauth_required | disconnected
  status                String    @default("disconnected")
  externalAccountId     String?   @map("external_account_id")
  accountLabel          String?   @map("account_label")
  scopes                String[]  @default([])
  accessTokenCipher     String?   @map("access_token_cipher")
  refreshTokenCipher    String?   @map("refresh_token_cipher")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  lastRefreshedAt       DateTime? @map("last_refreshed_at")
  lastValidatedAt       DateTime? @map("last_validated_at")
  lastError             String?   @map("last_error")
  reauthRequiredAt      DateTime? @map("reauth_required_at")
  metadata              Json?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([provider])
  @@index([status])
  @@map("sns_oauth_connections")
}

/// Structural observation of trending content — never stores copied captions/media/audio.
model SnsTrendObservation {
  id                 String    @id @default(cuid())
  platform           String
  locale             Locale    @default(en)
  category           String    @default("ai_tools")
  theme              String?
  hookPattern        String?   @map("hook_pattern")
  durationSec        Int?      @map("duration_sec")
  captionDensity     String?   @map("caption_density")
  subtitleStructure  String?   @map("subtitle_structure")
  sceneFlow          String?   @map("scene_flow")
  format             String?
  ctaPattern         String?   @map("cta_pattern")
  hashtagPatterns    String[]  @default([]) @map("hashtag_patterns")
  postedAtHour       Int?      @map("posted_at_hour")
  commentTendency    String?   @map("comment_tendency")
  plays              Int?
  likes              Int?
  saves              Int?
  shares             Int?
  comments           Int?
  whyItMayWork       Json      @default("[]") @map("why_it_may_work")
  sourceType         String    @map("source_type")
  sourceRef          String?   @map("source_ref")
  confidence         Float     @default(0.2)
  status             String    @default("active")
  humanNotes         String?   @map("human_notes")
  observedAt         DateTime  @default(now()) @map("observed_at")
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([platform, locale, status])
  @@index([observedAt])
  @@map("sns_trend_observations")
}

model SnsViralPattern {
  id                  String    @id @default(cuid())
  platform            String
  locale              Locale
  category            String    @default("ai_tools")
  patternType         String    @map("pattern_type")
  title               String
  summary             String
  structure           Json      @default("{}")
  analysisPeriodStart DateTime? @map("analysis_period_start")
  analysisPeriodEnd   DateTime? @map("analysis_period_end")
  sampleSize          Int       @default(0) @map("sample_size")
  confidence          Float     @default(0)
  evidence            Json      @default("[]")
  validUntil          DateTime? @map("valid_until")
  status              String    @default("active")
  humanOverride       Json?     @map("human_override")
  weight              Float     @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([platform, locale, patternType, status])
  @@map("sns_viral_patterns")
}

model SnsExperiment {
  id              String    @id @default(cuid())
  title           String
  hypothesis      String
  changeFactor    String    @map("change_factor")
  fixedFactors    Json      @default("[]") @map("fixed_factors")
  platform        String
  locale          Locale    @default(en)
  evaluationDays  Int       @default(7) @map("evaluation_days")
  successMetric   String    @map("success_metric")
  minSampleSize   Int       @default(2) @map("min_sample_size")
  abortCondition  String?   @map("abort_condition")
  status          String    @default("planned")
  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  resultSummary   String?   @map("result_summary")
  humanNotes      String?   @map("human_notes")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  variants SnsExperimentVariant[]
  posts    SocialPost[]

  @@index([platform, status])
  @@map("sns_experiments")
}

model SnsExperimentVariant {
  id           String @id @default(cuid())
  experimentId String @map("experiment_id")
  key          String
  label        String
  config       Json   @default("{}")

  experiment SnsExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, key])
  @@map("sns_experiment_variants")
}

/// Own-post metrics only. Missing platform fields stay null — never invent numbers.
model SnsPostMetrics {
  id              String   @id @default(cuid())
  socialPostId    String   @map("social_post_id")
  windowHours     Int      @map("window_hours")
  capturedAt      DateTime @default(now()) @map("captured_at")
  source          String   @default("manual")
  plays           Int?
  reach           Int?
  avgWatchSec     Float?   @map("avg_watch_sec")
  /// Overall watch retention / average watch ratio when provided
  watchRetentionRate Float? @map("watch_retention_rate")
  completionRate  Float?   @map("completion_rate")
  hold3SecRate    Float?   @map("hold_3sec_rate")
  likeRate        Float?   @map("like_rate")
  commentRate     Float?   @map("comment_rate")
  saveRate        Float?   @map("save_rate")
  shareRate       Float?   @map("share_rate")
  profileVisitRate Float?  @map("profile_visit_rate")
  linkClickRate   Float?   @map("link_click_rate")
  followRate      Float?   @map("follow_rate")
  /// Absolute engagement counts (TikTok / IG analytics)
  likesCount      Int?     @map("likes_count")
  commentsCount   Int?     @map("comments_count")
  sharesCount     Int?     @map("shares_count")
  savesCount      Int?     @map("saves_count")
  profileVisits   Int?     @map("profile_visits")
  affiliateClicks Int?     @map("affiliate_clicks")
  conversions     Int?
  revenue         Float?

  socialPost SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@index([socialPostId, windowHours])
  @@map("sns_post_metrics")
}

model SnsPostScore {
  id           String   @id @default(cuid())
  socialPostId String   @map("social_post_id")
  total        Float
  breakdown    Json     @default("{}")
  reasons      String[] @default([])
  improvements String[] @default([])
  riskLevel    String   @default("low") @map("risk_level")
  blocked      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  socialPost SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@index([socialPostId])
  @@map("sns_post_scores")
}

model SnsRecommendation {
  id               String   @id @default(cuid())
  theme            String
  platform         String
  locale           Locale
  audience         String?
  recommendedHook  String?  @map("recommended_hook")
  durationSec      Int?     @map("duration_sec")
  postedAtHint     String?  @map("posted_at_hint")
  cta              String?
  toolId           String?  @map("tool_id")
  affiliateLinkId  String?  @map("affiliate_link_id")
  goal             String?
  predictedScore   Float?   @map("predicted_score")
  rationale        String
  status           String   @default("proposed")
  humanNotes       String?  @map("human_notes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  posts SocialPost[]

  @@index([platform, locale, status])
  @@map("sns_recommendations")
}

model SnsLearningRecord {
  id               String    @id @default(cuid())
  kind             String
  platform         String?
  locale           Locale?
  theme            String?
  hookType         String?   @map("hook_type")
  ctaType          String?   @map("cta_type")
  title            String
  content          String
  metadata         Json      @default("{}")
  evidencePostIds  String[]  @default([]) @map("evidence_post_ids")
  importance       Float     @default(0.5)
  decayHalfLifeDays Int      @default(21) @map("decay_half_life_days")
  observedAt       DateTime  @default(now()) @map("observed_at")
  validUntil       DateTime? @map("valid_until")
  status           String    @default("active")
  humanCorrection  String?   @map("human_correction")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([kind, status])
  @@index([platform, locale])
  @@map("sns_learning_records")
}

model SnsImprovementLog {
  id        String   @id @default(cuid())
  agentKey  String   @map("agent_key")
  summary   String
  fromState Json?    @map("from_state")
  toState   Json?    @map("to_state")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([agentKey, createdAt])
  @@map("sns_improvement_logs")
}

model Agent {
  id           String      @id @default(cuid())
  key          String      @unique
  name         String
  version      String
  status       AgentStatus @default(active)
  config       Json        @default("{}")
  capabilities String[]    @default([])
  subscribe    String[]    @default([])
  publish      String[]    @default([])
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  /// Optional link to marketplace package version currently installed
  packageVersionId String? @map("package_version_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  plugins AgentPlugin[]
  runs    AgentRun[]
  packageVersion MarketplaceAgentVersion? @relation(fields: [packageVersionId], references: [id], onDelete: SetNull)
  installation   MarketplaceInstallation?

  @@map("agents")
}

model AgentPlugin {
  id        String   @id @default(cuid())
  agentId   String   @map("agent_id")
  pluginKey String   @map("plugin_key")
  version   String
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, pluginKey])
  @@map("agent_plugins")
}

model AgentRun {
  id            String         @id @default(cuid())
  agentKey      String         @map("agent_key")
  agentId       String?        @map("agent_id")
  correlationId String         @map("correlation_id")
  causationId   String?        @map("causation_id")
  eventId       String?        @map("event_id")
  workflowId    String?        @map("workflow_id")
  status        AgentRunStatus @default(pending)
  input         Json?
  output        Json?
  error         String?
  costUsd       Decimal?       @map("cost_usd") @db.Decimal(12, 6)
  tokensIn      Int?           @map("tokens_in")
  tokensOut     Int?           @map("tokens_out")
  startedAt     DateTime?      @map("started_at")
  finishedAt    DateTime?      @map("finished_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  agent    Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workflow Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  @@index([agentKey, createdAt])
  @@index([correlationId])
  @@index([workflowId])
  @@index([status])
  @@map("agent_runs")
}

model Workflow {
  id            String        @id @default(cuid())
  type          String
  entityType    String        @map("entity_type")
  entityId      String?       @map("entity_id")
  state         WorkflowState @default(started)
  localeTargets Locale[]      @default([en, ja]) @map("locale_targets")
  correlationId String        @unique @map("correlation_id")
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  workflowSteps WorkflowStep[]
  drafts        Draft[]
  agentRuns     AgentRun[]

  @@index([state])
  @@index([entityType, entityId])
  @@map("workflows")
}

model WorkflowStep {
  id         String             @id @default(cuid())
  workflowId String             @map("workflow_id")
  agentKey   String             @map("agent_key")
  stepKey    String             @map("step_key")
  status     WorkflowStepStatus @default(pending)
  attempt    Int                @default(0)
  lastError  String?            @map("last_error")
  startedAt  DateTime?          @map("started_at")
  finishedAt DateTime?          @map("finished_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepKey])
  @@index([workflowId, status])
  @@map("workflow_steps")
}

model Draft {
  id         String      @id @default(cuid())
  kind       DraftKind
  status     DraftStatus @default(building)
  locale     Locale?
  payload    Json
  toolId     String?     @map("tool_id")
  workflowId String?     @map("workflow_id")
  version    Int         @default(1)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  tool      AiTool?    @relation(fields: [toolId], references: [id], onDelete: SetNull)
  workflow  Workflow?  @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  approvals Approval[]

  @@index([status])
  @@index([workflowId])
  @@map("drafts")
}

model Approval {
  id         String           @id @default(cuid())
  draftId    String           @map("draft_id")
  reviewerId String?          @map("reviewer_id")
  decision   ApprovalDecision
  comment    String?
  decidedAt  DateTime         @default(now()) @map("decided_at")

  draft    Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  reviewer User? @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([draftId])
  @@map("approvals")
}

model EventsOutbox {
  id          String    @id
  topic       String
  payload     Json
  headers     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, createdAt])
  @@map("events_outbox")
}

model EventConsumption {
  id            String   @id @default(cuid())
  consumerGroup String   @map("consumer_group")
  eventId       String   @map("event_id")
  consumedAt    DateTime @default(now()) @map("consumed_at")

  @@unique([consumerGroup, eventId])
  @@map("event_consumptions")
}

model LogEntry {
  id         String   @id @default(cuid())
  level      String
  source     String
  message    String
  context    Json     @default("{}")
  correlationId String? @map("correlation_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([source, createdAt])
  @@index([correlationId])
  @@map("logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Critical operator alerts only — no noise for normal auto-ops.
model OpsAlert {
  id          String    @id @default(cuid())
  severity    String    @default("critical")
  kind        String
  title       String
  message     String
  provider    String?
  socialPostId String?  @map("social_post_id")
  toolId      String?   @map("tool_id")
  acknowledgedAt DateTime? @map("acknowledged_at")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([acknowledgedAt, createdAt])
  @@index([kind, createdAt])
  @@map("ops_alerts")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  properties Json    @default("{}")
  locale    Locale?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([name, createdAt])
  @@map("analytics")
}

model RevenueRecord {
  id          String   @id @default(cuid())
  source      String
  amountUsd   Decimal  @map("amount_usd") @db.Decimal(12, 2)
  toolId      String?  @map("tool_id")
  occurredAt  DateTime @map("occurred_at")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([occurredAt])
  @@map("revenue")
}

model ToolCandidate {
  id          String   @id @default(cuid())
  name        String
  homepageUrl String   @map("homepage_url")
  sourceName  String   @map("source_name")
  sourceUrl   String?  @map("source_url")
  externalId  String?  @map("external_id")
  description String?
  raw         Json     @default("{}")
  fingerprint String   @unique
  status      String   @default("new")
  workflowId  String?  @map("workflow_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([homepageUrl])
  @@map("tool_candidates")
}

// ─── Agent Marketplace ─────────────────────────────────────────────────────

enum MarketplaceVisibility {
  free
  paid
  internal
  community
}

enum MarketplaceListingStatus {
  draft
  published
  archived
  suspended
}

enum InstallationStatus {
  installed
  disabled
  pending_update
  uninstalled
}

/// Catalog entry — what can be discovered / sold / shared in the marketplace.
model MarketplaceAgentPackage {
  id           String                   @id @default(cuid())
  key          String                   @unique
  publisherId  String?                  @map("publisher_id")
  visibility   MarketplaceVisibility    @default(internal)
  listingStatus MarketplaceListingStatus @default(draft) @map("listing_status")
  /// Display metadata (i18n JSON: { en, ja })
  name         Json
  description  Json                     @default("{}")
  homepageUrl  String?                  @map("homepage_url")
  priceUsd     Decimal?                 @map("price_usd") @db.Decimal(12, 2)
  currency     String                   @default("USD")
  tags         String[]                 @default([])
  metadata     Json                     @default("{}")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  versions       MarketplaceAgentVersion[]
  permissions    MarketplaceAgentPermission[]
  dependencies   MarketplaceAgentDependency[]
  installations  MarketplaceInstallation[]

  @@index([visibility, listingStatus])
  @@map("marketplace_agent_packages")
}

/// Immutable-ish versioned release of a marketplace agent plugin.
model MarketplaceAgentVersion {
  id              String   @id @default(cuid())
  packageId       String   @map("package_id")
  version         String
  /// Full AgentManifest snapshot (JSON)
  manifest        Json
  changelog       String?
  requiredProviders Json   @default("{}") @map("required_providers")
  permissions     String[] @default([])
  isLatest        Boolean  @default(false) @map("is_latest")
  publishedAt     DateTime @default(now()) @map("published_at")
  createdAt       DateTime @default(now()) @map("created_at")

  package        MarketplaceAgentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  agents         Agent[]
  installations  MarketplaceInstallation[]

  @@unique([packageId, version])
  @@index([isLatest])
  @@map("marketplace_agent_versions")
}

model MarketplaceAgentPermission {
  id          String @id @default(cuid())
  packageId   String @map("package_id")
  permission  String
  description String?

  package MarketplaceAgentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, permission])
  @@map("marketplace_agent_permissions")
}

model MarketplaceAgentDependency {
  id              String @id @default(cuid())
  packageId       String @map("package_id")
  /// Target agent key (may reference runtime-only agents not yet listed)
  dependsOnKey    String @map("depends_on_key")
  /// Semver range, e.g. "^1.0.0" or ">=0.1.0"
  versionRange    String @default("*") @map("version_range")
  optional        Boolean @default(false)

  package MarketplaceAgentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, dependsOnKey])
  @@index([dependsOnKey])
  @@map("marketplace_agent_dependencies")
}

/// Local installation of a marketplace package into the runtime Agent registry.
model MarketplaceInstallation {
  id               String             @id @default(cuid())
  packageId        String             @map("package_id")
  packageVersionId String             @map("package_version_id")
  agentId          String             @unique @map("agent_id")
  status           InstallationStatus @default(installed)
  installedAt      DateTime           @default(now()) @map("installed_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  installedById    String?            @map("installed_by_id")
  metadata         Json               @default("{}")

  package        MarketplaceAgentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageVersion MarketplaceAgentVersion @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)
  agent          Agent                   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("marketplace_installations")
}

// ─── Knowledge Graph + Memory + RAG metadata ───────────────────────────────

enum KnowledgeNodeType {
  tool
  category
  company
  use_case
  pricing
  api
  feature
  persona
  competitor_set
  concept
  document
  other
}

enum KnowledgeEdgeType {
  similar_to
  competes_with
  belongs_to
  made_by
  used_for
  has_pricing
  has_api
  has_feature
  alternative_to
  related_to
  mentions
  derived_from
}

enum MemoryKind {
  run_success
  run_failure
  improvement
  observation
  decision
  feedback
  fact
}

enum MemoryScope {
  global
  agent
  workflow
  tool
  correlation
}

model KnowledgeNode {
  id          String            @id @default(cuid())
  type        KnowledgeNodeType
  key         String
  label       String
  locale      Locale?
  description String?
  /// Soft link to domain entity (e.g. ai_tools.id, categories.key)
  entityType  String?           @map("entity_type")
  entityId    String?           @map("entity_id")
  properties  Json              @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  edgesFrom KnowledgeEdge[] @relation("EdgeFrom")
  edgesTo   KnowledgeEdge[] @relation("EdgeTo")
  memories  AgentMemory[]
  documents KnowledgeDocument[]

  @@unique([type, key])
  @@index([entityType, entityId])
  @@index([type, label])
  @@map("knowledge_nodes")
}

model KnowledgeEdge {
  id         String            @id @default(cuid())
  fromNodeId String            @map("from_node_id")
  toNodeId   String            @map("to_node_id")
  type       KnowledgeEdgeType
  weight     Float             @default(1)
  properties Json              @default("{}")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  fromNode KnowledgeNode @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   KnowledgeNode @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, type])
  @@index([type])
  @@index([toNodeId, type])
  @@map("knowledge_edges")
}

model AgentMemory {
  id            String      @id @default(cuid())
  kind          MemoryKind
  scope         MemoryScope @default(agent)
  agentKey      String?     @map("agent_key")
  workflowId    String?     @map("workflow_id")
  correlationId String?     @map("correlation_id")
  toolId        String?     @map("tool_id")
  nodeId        String?     @map("node_id")
  title         String
  content       String
  /// Structured lesson / outcome payload
  metadata      Json        @default("{}")
  importance    Float       @default(0.5)
  /// Decay / retrieval boost helpers
  accessCount   Int         @default(0) @map("access_count")
  lastAccessedAt DateTime?  @map("last_accessed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  node KnowledgeNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([agentKey, kind, createdAt])
  @@index([scope, createdAt])
  @@index([correlationId])
  @@index([toolId])
  @@index([importance])
  @@map("agent_memories")
}

model KnowledgeDocument {
  id          String   @id @default(cuid())
  nodeId      String?  @map("node_id")
  sourceType  String   @map("source_type")
  sourceId    String?  @map("source_id")
  locale      Locale?
  title       String
  content     String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  node   KnowledgeNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  chunks KnowledgeChunk[]

  @@index([sourceType, sourceId])
  @@index([nodeId])
  @@map("knowledge_documents")
}

/// Chunk metadata; vector payload lives in VectorStore (pgvector / Qdrant / Pinecone / memory).
model KnowledgeChunk {
  id           String   @id @default(cuid())
  documentId   String   @map("document_id")
  chunkIndex   Int      @map("chunk_index")
  content      String
  tokenCount   Int?     @map("token_count")
  /// Opaque id in the active VectorStore
  vectorId     String?  @unique @map("vector_id")
  embeddingProvider String? @map("embedding_provider")
  embeddingModel    String? @map("embedding_model")
  dimensions   Int?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([vectorId])
  @@map("knowledge_chunks")
}

/// Portable vector rows for the default Postgres-backed store (JSON float array).
/// When VECTOR_BACKEND=pgvector, adapters may also use a real vector column via raw SQL.
model VectorRecord {
  id         String   @id
  namespace  String   @default("default")
  /// Float embedding as JSON array — backend-agnostic persistence
  embedding  Json
  dimensions Int
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([namespace])
  @@map("vector_records")
}

/// Self-Healing Agent incident + audit trail (never mutates production directly).
model SelfHealingIncident {
  id                String    @id @default(cuid())
  fingerprint       String
  title             String
  message           String
  kind              String
  severity          String    @default("medium")
  location          String?
  cause             String?
  status            String    @default("detected")
  attemptCount      Int       @default(0) @map("attempt_count")
  maxAttempts       Int       @default(3) @map("max_attempts")
  requiresApproval  Boolean   @default(false) @map("requires_approval")
  proposedFix       Json?     @map("proposed_fix")
  changedFiles      String[]  @default([]) @map("changed_files")
  testResults       Json?     @map("test_results")
  rollbackResult    Json?     @map("rollback_result")
  diffBefore        Json?     @map("diff_before")
  metadata          Json      @default("{}")
  healedAt          DateTime? @map("healed_at")
  acknowledgedAt    DateTime? @map("acknowledged_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  attempts SelfHealingAttempt[]

  @@index([fingerprint, createdAt])
  @@index([status, createdAt])
  @@index([requiresApproval, createdAt])
  @@map("self_healing_incidents")
}

model SelfHealingAttempt {
  id            String   @id @default(cuid())
  incidentId    String   @map("incident_id")
  attemptNumber Int      @map("attempt_number")
  action        String
  success       Boolean  @default(false)
  changedFiles  String[] @default([]) @map("changed_files")
  diff          Json?
  testResults   Json?    @map("test_results")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")

  incident SelfHealingIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, attemptNumber])
  @@map("self_healing_attempts")
}

/// AI BASE OS — multi-tenant marketing workspace (customer users)
model Workspace {
  id          String   @id @default(cuid())
  ownerUserId String   @map("owner_user_id")
  name        String
  setupDone   Boolean  @default(false) @map("setup_done")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner      User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  brand      BrandProfile?
  handles    SnsAccountHandle[]
  connections SnsConnection[]
  analyses   AccountAnalysis[]
  scores     AiScoreSnapshot[]
  taskSets   DailyTaskSet[]
  creatives  GeneratedCreative[]
  chatThreads OsChatThread[]
  briefs     DailyBrief[]
  improvements OsImprovementLog[]
  photoSessions OsPhotoSession[]

  @@index([ownerUserId])
  @@map("workspaces")
}

model BrandProfile {
  id              String   @id @default(cuid())
  workspaceId     String   @unique @map("workspace_id")
  brandName       String   @map("brand_name")
  industry        String   @default("")
  targetAudience  String   @default("") @map("target_audience")
  concept         String   @default("")
  worldview       String   @default("")
  colors          String   @default("")
  competitors     String   @default("")
  postTone        String   @default("") @map("post_tone")
  products        String   @default("")
  goals           String   @default("")
  memoryExtra     Json     @default("{}") @map("memory_extra")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
}

model SnsAccountHandle {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// instagram | tiktok | x | threads | youtube
  platform    String
  username    String
  connectionId String? @map("connection_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection SnsConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, platform])
  @@index([workspaceId])
  @@map("sns_account_handles")
}

/// Future OAuth / API connection (unused in V2 API-less flow)
model SnsConnection {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  provider           String
  status             String    @default("disconnected")
  externalAccountId  String?   @map("external_account_id")
  accountLabel       String?   @map("account_label")
  accessTokenCipher  String?   @map("access_token_cipher")
  refreshTokenCipher String?   @map("refresh_token_cipher")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  scopes             String[]  @default([])
  metadata           Json      @default("{}")
  lastError          String?   @map("last_error")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  handles   SnsAccountHandle[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@map("os_sns_connections")
}

model AccountAnalysis {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  platform     String?
  summary      String
  findings     Json     @default("[]")
  nextActions  Json     @default("[]") @map("next_actions")
  detail       Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("account_analyses")
}

model AiScoreSnapshot {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  overall      Int
  platforms    Json     @default("{}")
  reasons      Json     @default("[]")
  nextActions  Json     @default("[]") @map("next_actions")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("ai_score_snapshots")
}

model DailyTaskSet {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// YYYY-MM-DD in workspace locale / Asia/Tokyo
  dateKey     String   @map("date_key")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     DailyTaskItem[]

  @@unique([workspaceId, dateKey])
  @@map("daily_task_sets")
}

model DailyTaskItem {
  id          String    @id @default(cuid())
  taskSetId   String    @map("task_set_id")
  title       String
  detail      String    @default("")
  category    String    @default("general")
  priority    Int       @default(0)
  deepLink    String?   @map("deep_link")
  doneAt      DateTime? @map("done_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  taskSet DailyTaskSet @relation(fields: [taskSetId], references: [id], onDelete: Cascade)

  @@index([taskSetId])
  @@map("daily_task_items")
}

model GeneratedCreative {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  platform    String   @default("instagram")
  caption     String   @default("")
  hashtags    String[] @default([])
  reelScript  String   @default("") @map("reel_script")
  imagePrompt String   @default("") @map("image_prompt")
  imageUrl    String?  @map("image_url")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("generated_creatives")
}

model OsChatThread {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  title       String   @default("AI社員")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  OsChatMessage[]
  briefs    DailyBrief[]

  @@index([workspaceId, updatedAt])
  @@map("os_chat_threads")
}

model OsChatMessage {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  role      String
  content   String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  thread OsChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("os_chat_messages")
}

model DailyBrief {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  dateKey     String   @map("date_key")
  threadId    String?  @map("thread_id")
  messageId   String?  @map("message_id")
  content     String
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread    OsChatThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, dateKey])
  @@map("daily_briefs")
}

/// AI社員が学習する改善履歴（実行内容と成果）
model OsImprovementLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// YYYY-MM-DD Asia/Tokyo
  dateKey     String   @map("date_key")
  title       String
  /// cause → improvement → execution narrative
  cause       String   @default("")
  action      String   @default("")
  /// e.g. 保存率+14%
  result      String   @default("")
  platform    String?
  source      String   @default("manual")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, dateKey])
  @@index([workspaceId, createdAt])
  @@map("os_improvement_logs")
}

/// AI Photo Studio session (upload → analyze → enhance → posts)
model OsPhotoSession {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  status           String   @default("uploaded")
  /// Compressed data URL or remote URL (provider later)
  originalUrl      String   @map("original_url") @db.Text
  /// Enhanced image URL when provider returns pixels; else empty and use CSS recipe
  enhancedUrl      String?  @map("enhanced_url") @db.Text
  mimeType         String   @default("image/jpeg") @map("mime_type")
  width            Int?
  height           Int?
  fileName         String?  @map("file_name")
  platformTarget   String   @default("instagram") @map("platform_target")
  analysis         Json     @default("{}")
  enhanceRecipe    Json     @default("{}") @map("enhance_recipe")
  shootAdvice      Json     @default("[]") @map("shoot_advice")
  brandPreset      Json     @default("{}") @map("brand_preset")
  postVariants     Json     @default("[]") @map("post_variants")
  predictions      Json     @default("{}")
  provider         String   @default("heuristic")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("os_photo_sessions")
}
